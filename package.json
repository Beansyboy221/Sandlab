{
  "name": "sandlab",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 3000 --bind 0.0.0.0",
    "test": "node --test tests/simulation.test.js tests/presets.test.js tests/selection.test.js tests/settings.test.js tests/materials.test.js tests/security.test.js tests/editor.test.js tests/ignition.test.js tests/inspection.test.js tests/level.test.js tests/energy.test.js tests/elasticity.test.js tests/canvas-view.test.js tests/paint.test.js tests/atmosphere.test.js tests/bodies-fill.test.js tests/touch-navigation.test.js tests/rigid-physics.test.js tests/stickmen.test.js",
    "bench": "node tests/benchmark.js",
    "test:browser": "python3 tests/browser_check.py",
    "format": "prettier --write \"src/**/*.js\" \"tests/*.js\" index.html style.css README.md",
    "build": "node scripts/build.mjs",
    "test:experiments": "python3 tests/experiments_check.py",
    "test:inspection": "python3 tests/inspection_check.py",
    "test:security": "python3 tests/security_check.py",
    "test:levels": "python3 tests/level_check.py",
    "test:energy": "python3 tests/energy_check.py",
    "test:drawing": "python3 tests/drawing_check.py",
    "test:mobile-layout": "python3 tests/mobile_layout_check.py",
    "test:elastics": "python3 tests/elastics_check.py",
    "test:contacts": "python3 tests/elastic_contacts_check.py",
    "test:atmosphere": "python3 tests/atmosphere_check.py",
    "test:paint": "python3 tests/paint_check.py",
    "test:fill": "python3 tests/fill_bodies_check.py",
    "test:gestures": "python3 tests/touch_gestures_check.py",
    "test:rigid": "python3 tests/rigid_physics_check.py",
    "test:solid-drawing": "python3 tests/solid_drawing_check.py",
    "test:stickmen": "python3 tests/stickmen_check.py"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
